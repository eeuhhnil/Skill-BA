{
  "mcpServers": {
    "reqwise-figma": {
      "type": "stdio",
      "command": "node",
      "args": ["C:/Users/admin/Desktop/reqwise-figma-mcp/dist/server/index.js"]
    },
    "confluence": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-atlassian"],
      "env": {
        "CONFLUENCE_URL": "https://confluence-sds.softdreams.vn:8090",
        "CONFLUENCE_PERSONAL_TOKEN": "${CONFLUENCE_PAT}",
        "CONFLUENCE_SPACES_FILTER": "${CONFLUENCE_SPACE:-EP}",
        "READ_ONLY_MODE": "true"
      }
    }
  }
}