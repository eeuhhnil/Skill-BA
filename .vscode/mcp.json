{
  "inputs": [
    {
      "type": "promptString",
      "id": "confluence-pat",
      "description": "Confluence Personal Access Token (confluence-sds.softdreams.vn)",
      "password": true
    },
    {
      "type": "promptString",
      "id": "figma-pat",
      "description": "Figma Personal Access Token",
      "password": true
    }
  ],
  "servers": {
    "confluence": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-atlassian"],
      "env": {
        "CONFLUENCE_URL": "https://confluence-sds.softdreams.vn:8090",
        "CONFLUENCE_PERSONAL_TOKEN": "${input:confluence-pat}",
        "CONFLUENCE_SPACES_FILTER": "EP",
        "READ_ONLY_MODE": "true"
      }
    },
    "figma": {
      "command": "npx",
      "args": ["-y", "figma-ui-mcp"]
    }
  }
}
